stage.Name="LegendaryFullBodyRestore"
stage.Parent=game.ServerStorage
for _,record in ipairs(records) do
 local model=Instance.new("Model")
 model.Name=record.name
 model.Parent=stage
 for key,value in pairs(record.attributes) do model:SetAttribute(key,value) end
 for _,p in ipairs(record.parts) do
  local mesh=game:GetService("AssetService"):CreateMeshPartAsync(Content.fromUri(p.mesh))
  mesh.Name=p.name
  mesh.TextureID=p.texture
  mesh.Size=Vector3.new(table.unpack(p.size))
  mesh.CFrame=CFrame.new(table.unpack(p.cf))
  mesh.Color=Color3.new(table.unpack(p.color))
  mesh.Material=Enum.Material[p.material]
  mesh.Transparency=p.transparency
  mesh.Reflectance=p.reflectance
  mesh.DoubleSided=p.doubleSided
  mesh.Anchored=true mesh.CanCollide=false mesh.CanTouch=false mesh.CanQuery=false mesh.Massless=true
  mesh.Parent=model
 end
 model.WorldPivot=CFrame.new()
 local _,size=model:GetBoundingBox()
 assert(math.abs(math.max(size.X,size.Y,size.Z)-7)<.01, "Invalid model bounds")
end

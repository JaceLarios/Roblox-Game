local function decode(x)
 if type(x)~="table" or not x.t then return x end
 if x.t=="Vector3" then return Vector3.new(unpack(x.v))
 elseif x.t=="Vector2" then return Vector2.new(unpack(x.v))
 elseif x.t=="Color3" then return Color3.new(unpack(x.v))
 elseif x.t=="CFrame" then return CFrame.new(unpack(x.v))
 elseif x.t=="UDim2" then return UDim2.new(unpack(x.v))
 elseif x.t=="UDim" then return UDim.new(unpack(x.v))
 elseif x.t=="EnumItem" then return Enum[x.e:gsub("^Enum%.","")][x.v] end
 error("Unsupported value "..tostring(x.t))
end
local staged=Instance.new("Folder")
staged.Name="DetailedVehicleRestoreStaging"
local ok,err=pcall(function()
 for name,records in pairs(recordsByName) do
  local objects={}
  for _,r in ipairs(records) do
   local o
   if r.class=="MeshPart" then
    o=game:GetService("AssetService"):CreateMeshPartAsync(Content.fromUri(r.properties.MeshId))
   else o=Instance.new(r.class) end
   o.Name=r.name
   for k,v in pairs(r.properties) do if k~="MeshId" then o[k]=decode(v) end end
   for k,v in pairs(r.attributes) do o:SetAttribute(k,decode(v)) end
   objects[r.id]=o
   o.Parent=r.parent==0 and staged or assert(objects[r.parent],"Missing parent")
  end
  local model=staged[name]
  model.WorldPivot=CFrame.new()
 end
end)
if not ok then staged:Destroy() error(err) end
local templates=game.ReplicatedStorage:WaitForChild("ItemModels")
local backup=Instance.new("Folder") backup.Name="BeforeDetailedVehicleRestore_"..os.time() backup.Parent=game.ServerStorage
for _,model in staged:GetChildren() do
 local old=templates:FindFirstChild(model.Name)
 if old then old.Parent=backup end
 model.Parent=templates
end
staged:Destroy()
print("Restored seven detailed vehicles; previous versions retained in "..backup:GetFullName())

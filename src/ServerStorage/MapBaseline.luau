local function decode(x)
 if x.t == "Vector3" then return Vector3.new(table.unpack(x.v))
 elseif x.t == "CFrame" then return CFrame.new(table.unpack(x.v))
 elseif x.t == "Color3" then return Color3.new(table.unpack(x.v))
 elseif x.t == "EnumItem" then return Enum[x.e][x.v]
 elseif x.t == "BrickColor" then return BrickColor.new(x.v)
 else return x.v end
